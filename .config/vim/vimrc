" vim:fileencoding=utf-8:foldmethod=marker

ru settings.vim
ru maps.vim
ru plugins.vim

" Load plugins
ru ftplugin/man.vim
let g:no_man_maps = 1
let g:ft_man_open_mode = 'tab'

pa helptoc

" C syntax options
let c_no_curly_error = 1
let c_space_errors = 1
let c_comment_strings = 1
let c_functions = 0

function CSyntaxFunctionToggle()
	if exists("c_functions")
		unlet g:c_functions
	else
		let g:c_functions = 1
	endif

	syn on
endfunc

nnoremap <Leader>.cf :call CSyntaxFunctionToggle()<CR>

au BufNewFile,BufRead *.sp,*.cir,*.spice setf spice
au BufNewFile,BufRead config,*.config setf config
au FileType scheme,lisp set expandtab

sy on
noh

" Colorscheme
set tgc bg=dark
colo sorbet
