" Settings
set encoding=UTF-8
set vi='32,<256,:4096,/256,%
set vif=~/.local/state/vim/viminfo
set ssop=buffers,folds,help,options,tabpages,winsize,terminal,sesdir
set bdir=./.vimbackup,~/.local/share/vim/backup,.,~/tmp,~/
set udf udir=~/.local/share/vim/undo
set history=4096
set noex secure

" UI options
set ru shm=atToO nu rnu cul nocuc
set wmnu wop=pum ph=32
set sc ls=2 stal=1

set go=cdiM

set fen cole=0
set fcs=vert:\|,fold:-,eob:\ ,lastline:@

" Search Options
set ic scs hls is ws

" Indentation Options
set cin ai noet sta ts=4 sw=4 sts=0

" Behavior
set ar noaw noawa noasd bs=indent,eol,start


